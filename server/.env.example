GEMINI_API_KEY=
# Optional: automatic fallback when Gemini's free-tier quota is exhausted
# (429). Vision (extraction) and text (query/digest) calls both fall back.
# See server/llm.ts.
GROQ_API_KEY=
# Optional: digital receipt emails on record approval. All three must be set
# for it to send; if unset (or if sending fails), approval still succeeds --
# email is non-blocking. See server/services/email.ts.
SENDGRID_API_KEY=
RECEIPT_SENDER_EMAIL=
RECEIPT_RECIPIENT_EMAIL=
PORT=3000
FIREBASE_PROJECT_ID=gdgdeployordie
FIREBASE_STORAGE_BUCKET=gdgdeployordie.firebasestorage.app
# Path to a Firebase service account JSON (server-side credential for
# Firestore/Storage access). Never commit the actual file.
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
